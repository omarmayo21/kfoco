# ==============================================================================
# Khaled Alfagih Engineering Consultancy Company (KFO) - Environment Variables
# Safe defaults are provided so the project builds cleanly even if unset.
# ==============================================================================

# Canonical production URL (used for sitemap.xml, robots.txt, canonical links, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kfoco.com

# Direct WhatsApp contact number (international format with country code, e.g. +966506515861)
NEXT_PUBLIC_WHATSAPP_NUMBER=+966506515861

# Google Analytics 4 Measurement ID (optional, leave empty in staging/preview builds)
NEXT_PUBLIC_GA_ID=
